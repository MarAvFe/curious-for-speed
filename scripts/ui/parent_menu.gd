extends CanvasLayer
## Parent menu (text is fine here). Opened by holding F1 or Start+Select for 3 s. English + Spanish.

const STR := {
	"title": ["Parent menu", "Menú para padres"],
	"music": ["Music volume", "Volumen de música"],
	"sfx": ["Effects volume", "Volumen de efectos"],
	"speed": ["Game speed", "Velocidad del juego"],
	"retro": ["Retro pixel look", "Aspecto retro pixelado"],
	"fullscreen": ["Fullscreen", "Pantalla completa"],
		"deadzone": ["Stick deadzone", "Zona muerta del stick"],
	"learn": ["Set up a controller…", "Configurar un mando…"],
	"reset_bind": ["Reset controls", "Restablecer controles"],
	"reset_save": ["Reset progress (hold)", "Borrar progreso (mantener)"],
	"credits": ["Credits", "Créditos"],
	"lang": ["Español", "English"],
	"close": ["Back to game", "Volver al juego"],
	"quit": ["Quit game", "Salir del juego"],
	"press": ["Press the button / stick for: %s", "Pulsa el botón / stick para: %s"],
	"done": ["Controller saved.", "Mando guardado."],
	"reset_done": ["Progress reset.", "Progreso borrado."],
	"live": ["Live input: %s", "Entrada en vivo: %s"],
	"nitro": ["NITRO", "NITRO"], "honk": ["HORN", "BOCINA"], "steer_left": ["LEFT", "IZQUIERDA"], "steer_right": ["RIGHT", "DERECHA"],
	"steer_up": ["UP", "ARRIBA"], "steer_down": ["BRAKE", "FRENO"], "pause": ["PAUSE", "PAUSA"],
}
const LEARN_ORDER := ["nitro", "honk", "steer_left", "steer_right", "pause"]
const CREDITS := """curious-for-speed

Design, code, art, sound and music generated by this project's own scripts
(build123d CAD geometry + trimesh, Python-synthesised audio).

Made with Godot Engine (MIT licence) — godotengine.org
Python libraries: build123d (Apache-2.0, on OpenCascade/OCP), trimesh, NumPy, SciPy, Pillow.

Thank you for racing with your little one."""

var _box: VBoxContainer
var _status: Label
var _live: Label
var _learn_i := -1
var _reset_hold := 0.0
var _reset_btn: Button
var _first: Control


func _ready() -> void:
	layer = 50
	process_mode = Node.PROCESS_MODE_ALWAYS
	_build()


func t(key: String) -> String:
	return STR[key][0 if str(Save.setting("lang")) == "en" else 1]


func _build() -> void:
	for c in get_children():
		c.queue_free()
	var bg := ColorRect.new()
	bg.color = Color(0.13, 0.12, 0.2, 0.94)
	bg.set_anchors_preset(Control.PRESET_FULL_RECT)
	add_child(bg)
	var sc := ScrollContainer.new()
	sc.set_anchors_preset(Control.PRESET_FULL_RECT)
	sc.offset_left = 24
	sc.offset_top = 12
	sc.offset_right = -24
	sc.offset_bottom = -12
	add_child(sc)
	_box = VBoxContainer.new()
	_box.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	sc.add_child(_box)
	_label(t("title"), 22)
	_first = _slider("music", 0.0, 1.0, 0.05)
	_slider("sfx", 0.0, 1.0, 0.05)
	_options("speed", [0.5, 0.6, 0.7, 0.8, 0.9, 1.0, 1.15, 1.3, 1.5])
	_check("retro")
	_check("fullscreen")
	_slider("deadzone", 0.05, 0.5, 0.05)
	_button(t("learn"), _start_learn)
	_button(t("reset_bind"), func() -> void: Bindings.reset_bindings(); _status.text = t("done"))
	_reset_btn = _button(t("reset_save"), func() -> void: pass)
	_button(t("credits"), func() -> void: _status.text = CREDITS)
	_button(t("lang"), func() -> void: Save.set_setting("lang", "es" if str(Save.setting("lang")) == "en" else "en"); _build())
	_button(t("close"), close)
	_button(t("quit"), func() -> void: get_tree().quit())
	_status = _label("", 14)
	_status.autowrap_mode = TextServer.AUTOWRAP_WORD
	_live = _label("", 12)
	_first.grab_focus.call_deferred()


func _label(txt: String, size: int) -> Label:
	var l := Label.new()
	l.text = txt
	l.add_theme_font_size_override("font_size", size)
	_box.add_child(l)
	return l


func _row(key: String) -> HBoxContainer:
	var h := HBoxContainer.new()
	var l := Label.new()
	l.text = t(key)
	l.custom_minimum_size.x = 220
	h.add_child(l)
	_box.add_child(h)
	return h


func _slider(key: String, lo: float, hi: float, step: float) -> Control:
	var s := HSlider.new()
	s.min_value = lo
	s.max_value = hi
	s.step = step
	s.value = float(Save.setting(key))
	s.custom_minimum_size.x = 220
	s.value_changed.connect(func(v: float) -> void:
		Save.set_setting(key, v)
		if key == "deadzone":
			Bindings.rebuild())
	_row(key).add_child(s)
	return s


func _options(key: String, vals: Array) -> void:
	var o := OptionButton.new()
	for v: float in vals:
		o.add_item("%d%%" % roundi(v * 100))
	var cur := float(Save.setting(key))
	var best := 0
	for i in vals.size():  # nearest preset, so older saves still show sensibly
		if absf(float(vals[i]) - cur) < absf(float(vals[best]) - cur):
			best = i
	o.selected = best
	o.item_selected.connect(func(i: int) -> void: Save.set_setting(key, vals[i]))
	_row(key).add_child(o)


func _check(key: String) -> void:
	var c := CheckButton.new()
	c.button_pressed = bool(Save.setting(key))
	c.toggled.connect(func(v: bool) -> void: Save.set_setting(key, v))
	_row(key).add_child(c)


func _button(txt: String, cb: Callable) -> Button:
	var b := Button.new()
	b.text = txt
	b.alignment = HORIZONTAL_ALIGNMENT_LEFT
	b.pressed.connect(cb)
	_box.add_child(b)
	return b


func _start_learn() -> void:
	_learn_i = 0
	_status.text = t("press") % t(LEARN_ORDER[0])


func _input(ev: InputEvent) -> void:
	if _learn_i < 0:
		return
	var ok := (ev is InputEventJoypadButton and ev.is_pressed()) \
		or (ev is InputEventJoypadMotion and absf((ev as InputEventJoypadMotion).axis_value) > 0.6) \
		or (ev is InputEventKey and ev.is_pressed() and not ev.is_echo())
	if not ok:
		return
	get_viewport().set_input_as_handled()
	if ev is InputEventJoypadMotion:  # store direction only
		var m := (ev as InputEventJoypadMotion).duplicate() as InputEventJoypadMotion
		m.axis_value = signf(m.axis_value)
		ev = m
	Bindings.learn(LEARN_ORDER[_learn_i], ev)
	AudioBus.play("sfx_blip")
	_learn_i += 1
	if _learn_i >= LEARN_ORDER.size():
		_learn_i = -1
		_status.text = t("done")
	else:
		_status.text = t("press") % t(LEARN_ORDER[_learn_i])


func _process(dt: float) -> void:
	if _learn_i < 0 and Input.is_action_just_pressed("menu_back"):
		close()
		return
	# live input values (diagnosing odd adapters)
	var parts: PackedStringArray = []
	for j: int in Input.get_connected_joypads():
		var ax: PackedStringArray = []
		for a in 6:
			ax.append("%.1f" % Input.get_joy_axis(j, a as JoyAxis))
		var bs: PackedStringArray = []
		for b in 16:
			if Input.is_joy_button_pressed(j, b as JoyButton):
				bs.append(str(b))
		parts.append("#%d %s axes[%s] buttons[%s]" % [j, Input.get_joy_name(j), ", ".join(ax), ", ".join(bs)])
	_live.text = t("live") % (" | ".join(parts) if parts.size() > 0 else "-")
	# reset progress requires holding the button 2 s
	var aimed := _reset_btn != null and (_reset_btn.is_hovered() or _reset_btn.has_focus())
	if aimed:
		if _reset_btn.button_pressed or Input.is_action_pressed("ui_accept"):
			_reset_hold += dt
			_reset_btn.modulate = Color.WHITE.lerp(Color(1, 0.5, 0.5), _reset_hold / 2.0)
			if _reset_hold >= 2.0:
				Save.reset()
				_reset_hold = -INF
				_status.text = t("reset_done")
			return
	_reset_hold = 0.0
	if _reset_btn:
		_reset_btn.modulate = Color.WHITE


func close() -> void:
	if is_queued_for_deletion():
		return
	queue_free()
	get_tree().paused = false
	get_tree().call_group("pausable", "parent_menu_closed")  # land on the child's pause menu, not straight into play
